{
  "version": 2,
  "builds": [
    {
      "src": "build/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "src/public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/socket.io/(.*)",
      "dest": "build/server.js"
    },
    {
      "src": "/public/(.*)",
      "dest": "src/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "build/server.js"
    }
  ]
} 